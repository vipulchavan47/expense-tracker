<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensetracker.ui.LoginController">

    <Label text="Expense Tracker Login"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="nameField" promptText="Name (for register)"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>

    <Button text="Login" onAction="#onLogin"/>
    <Button text="Register" onAction="#onRegister"/>

    <Label fx:id="statusLabel"/>
</VBox>
