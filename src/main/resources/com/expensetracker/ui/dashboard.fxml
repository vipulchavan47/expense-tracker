<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensetracker.ui.DashboardController">



    <Label text="Expense Tracker"
           style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <Button text="Add Expense"
            fx:id="addExpenseBtn"
            onAction="#onAddExpenseClick"/>

    <Button text="View Expenses"
            onAction="#onViewExpensesClick"/>

    <Button text="Monthly Summary"
            onAction="#onMonthlySummaryClick"/>

    <Button text="Charts"
            onAction="#onChartsClick"/>

    <Button text="Add Category"
            onAction="#onAddCategoryClick"/>


    <Button text="Logout"
            onAction="#onLogout"/>


</VBox>
